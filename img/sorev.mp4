          font-weight: 400;
          
        }

        @font-face {
          font-family: 'Pin Sans';
          src: url('https://s.pinimg.com/webapp/Pin-Sans-MacOS-Medium-704a4f34.woff2') format('woff2');
          font-weight: 500;
          
        }

        @font-face {
          font-family: 'Pin Sans';
          src: url('https://s.pinimg.com/webapp/Pin-Sans-MacOS-Bold-ce475d98.woff2') format('woff2');
          font-weight: 700;
          
        }

